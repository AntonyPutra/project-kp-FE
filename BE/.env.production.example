# ============================================================
# SICAMS Backend - .env Production
# Server: Ubuntu Docker
# Domain: api.whaleestudio.my.id
# ============================================================

APP_NAME="SICAMS API"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_HERE=
APP_DEBUG=false
APP_URL=https://api.whaleestudio.my.id
FRONTEND_URL=https://sicams.whaleestudio.my.id

# Frontend Domain untuk CORS
SANCTUM_STATEFUL_DOMAINS=sicams.whaleestudio.my.id

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (Sesuai docker-compose.prod.yml)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sicams_production
DB_USERNAME=sicams_user
DB_PASSWORD=SicamsDB2026!

# Authentication & JWT
JWT_SECRET=GENERATE_NEW_JWT_SECRET_HERE
JWT_ALGO=RS256
JWT_PUBLIC_KEY="storage/keys/jwt-public.key"
JWT_PRIVATE_KEY="storage/keys/jwt-private.key"
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Redis Cache & Queue
CACHE_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

REDIS_HOST=redis
REDIS_PASSWORD=SicamsRedis2026!
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Mail Configuration (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=admin@whaleestudio.my.id
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=admin@whaleestudio.my.id
MAIL_FROM_NAME="SICAMS Administrator"

# Blockchain Audit Configuration
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NODE_URL=local
BLOCKCHAIN_DIFFICULTY=4

# Storage Configuration
FILESYSTEM_DISK=public

# Security Settings
MFA_ENABLED=true
OTP_EXPIRY=5
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=15

# Monitoring
TELESCOPE_ENABLED=false
