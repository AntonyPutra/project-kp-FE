# ============================================================
# SICAMS Frontend - .env Production
# ============================================================

# Application
VITE_APP_NAME="SICAMS"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="production"

# API Base URL (Backend via Cloudflare Tunnel)
VITE_API_URL="https://api.whaleestudio.my.id"
VITE_API_TIMEOUT=30000

# Frontend URL
VITE_APP_URL="https://sicams.whaleestudio.my.id"

# Feature Flags
VITE_ENABLE_MFA=true
VITE_ENABLE_BLOCKCHAIN=true
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_QR_CODE=true

# Blockchain Explorer
VITE_BLOCKCHAIN_EXPLORER_URL="https://sicams.whaleestudio.my.id/blockchain"
